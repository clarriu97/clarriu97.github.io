# Copy to .env (gitignored) and fill in. Load with: uv run --env-file .env uvicorn app.main:app --reload

# Your personal AWS CLI profile — never the work default. See ../README.md.
AWS_PROFILE=personal-twin
AWS_REGION_NAME=eu-west-1

# Real DynamoDB table name, from `terraform output rate_limit_table`
RATE_LIMIT_TABLE=larri-aws-bot-prod-rate-limit

# Bedrock inference-profile model ID — must match a region you have model access in.
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0

# Cloudflare's public "always passes" test secret — same one worker/README.md
# uses for local dev. Swap for the real secret only when testing Turnstile itself.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

ALLOWED_ORIGINS=http://localhost:4321
