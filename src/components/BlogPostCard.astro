---
interface Props {
  title: string
  description: string
  pubDate: Date
  slug: string
  tags?: string[]
  featured?: boolean
}

const { title, description, pubDate, slug, tags = [], featured = false } = Astro.props

const dateLabel = pubDate.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
})
---

<a
  href={`/blog/${slug}`}
  class:list={[
    "group block rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 transition duration-300",
    "hover:-translate-y-0.5 hover:border-[var(--accent-soft)] hover:shadow-[0_16px_40px_rgba(0,0,0,0.12)]",
    featured && "ring-1 ring-[var(--accent-soft)]",
  ]}
>
  <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--muted)]">
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    {
      featured && (
        <span class="rounded-full border border-[var(--accent-soft)] bg-[var(--accent-soft)] px-2 py-0.5 text-[var(--text)]">
          Featured
        </span>
      )
    }
  </div>
  <h2
    class="mt-3 text-xl font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--accent)]"
  >
    {title}
    <span class="ml-1 inline-block transition-transform group-hover:translate-x-0.5" aria-hidden="true"
      >&rarr;</span
    >
  </h2>
  <p class="mt-2 text-[var(--muted)] leading-relaxed">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <span class="rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-2 py-0.5 text-xs text-[var(--text)]">
              {tag}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</a>
