---
import Link from "@/components/icons/Link.astro"
import LinkButton from "@/components/LinkButton.astro"
---

<div
  class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 transition duration-300 hover:border-[var(--accent-soft)] hover:shadow-[0_16px_40px_rgba(0,0,0,0.12)] md:p-8"
>
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <p class="text-sm font-medium uppercase tracking-wide text-[var(--accent)]">
        Writing
      </p>
      <p class="mt-3 text-[var(--muted)] leading-relaxed">
        Longer notes on backend work, DevOps, and experiments. Use <strong class="font-medium text-[var(--text)]">Blog</strong> in the menu for the full list of posts; this block is a quick preview on the portfolio.
      </p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
      <LinkButton href="/blog" external={false}>
        <Link class="size-5" />
        Browse all posts
      </LinkButton>
    </div>
  </div>
</div>
