---
import { getCollection, type CollectionEntry } from "astro:content"

import BreadcrumbBar from "@/components/BreadcrumbBar.astro"
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content } = await post.render()

const { title, description, pubDate, updatedDate, tags = [] } = post.data
const canonicalPath = `/blog/${post.slug}`

const breadcrumbTitle =
  title.length > 48 ? `${title.slice(0, 45).trimEnd()}…` : title

const dateLabel = pubDate.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
})

const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    "@type": "Person",
    name: "Carlos Larriu",
    url: "https://larri.dev/",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(canonicalPath, Astro.site).href,
  },
}
---

<Layout
  title={`${title} | Carlos Larriu`}
  description={description}
  type="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
  </Fragment>
  <main class="px-4">
    <article class="pb-24 md:pb-32">
      <SectionContainer class="pt-24 md:pt-32">
        <BreadcrumbBar
          items={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog" },
            { label: breadcrumbTitle },
          ]}
        />
        <header class="mt-10 max-w-3xl">
          <p class="text-sm text-[var(--muted)]">
            <time datetime={pubDate.toISOString()}>{dateLabel}</time>
            {
              updatedDate && (
                <>
                  {" "}
                  · updated{" "}
                  <time datetime={updatedDate.toISOString()}>
                    {updatedDate.toLocaleDateString("en-GB", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                </>
              )
            }
          </p>
          <h1 class="mt-4 text-4xl font-semibold tracking-tight text-[var(--text)] sm:text-5xl">
            {title}
          </h1>
          <p class="mt-4 text-lg text-[var(--muted)]">{description}</p>
          {
            tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li>
                    <span class="rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-3 py-1 text-xs text-[var(--text)]">
                      {tag}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
        </header>
      </SectionContainer>

      <SectionContainer class="pt-2">
        <div class="blog-content max-w-3xl">
          <Content />
        </div>
      </SectionContainer>
    </article>
  </main>
</Layout>

<style is:global>
  .blog-content {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text);
  }

  .blog-content > * + * {
    margin-top: 1.25em;
  }

  .blog-content h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .blog-content h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
  }

  .blog-content p {
    color: var(--muted);
  }

  .blog-content strong {
    color: var(--text);
    font-weight: 600;
  }

  .blog-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s ease;
  }

  .blog-content a:hover {
    opacity: 0.85;
  }

  .blog-content ul,
  .blog-content ol {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    color: var(--muted);
  }

  .blog-content li + li {
    margin-top: 0.35em;
  }

  .blog-content li::marker {
    color: var(--accent);
  }

  .blog-content hr {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }

  .blog-content code {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .blog-content pre {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.9em;
  }

  .blog-content pre code {
    padding: 0;
    border: none;
    background: transparent;
  }

  .blog-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }

  .blog-content figure {
    margin: 1.5rem 0 0;
  }

  .blog-content figure img {
    display: block;
    width: 100%;
  }

  .blog-content figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .blog-content figcaption code {
    font-size: 0.85em;
  }
</style>
